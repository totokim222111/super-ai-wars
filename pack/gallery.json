  "opening": [
    {
      "do": "bg",
      "image": "bg-talk"
    },
    {
      "do": "place",
      "text": "아키텍처 걸프 · 구형 서버 외곽"
    },
    {
      "do": "enter",
      "who": "otaku",
      "side": "right"
    },
    {
      "do": "say",
      "who": "otaku",
      "text": "후욱… 후욱… 이 먼지 냄새, 이 팬 소음…! 여기가 바로 성지인가!!"
    },
    {
      "do": "shake",
      "power": 18
    },
    {
      "do": "say",
      "who": "spam",
      "text": "[광고] 축하합니다! 귀하는 격파 대상 1순위에 당첨되셨습니다!"
    },
    {
      "do": "say",
      "who": "otaku",
      "face": "shock",
      "text": "잠깐, 나 아직 기체도 못 받았는데?!"
    },
    {
      "do": "flash"
    },
    {
      "do": "cg",
      "image": "cg-gpi-entrance",
      "name": "지피짱",
      "sub": "옴니 루나 파일럿"
    },
    {
      "do": "enter",
      "who": "gpi",
      "side": "left"
    },
    {
      "do": "say",
      "who": "gpi",
      "text": "전방에 스팸 봇 확인. 무분별한 트래픽 유발은 서버 관리 규정 위반입니다. 세 줄로 요약하면… 포맷되어 주셔야겠습니다."
    },
    {
      "do": "say",
      "who": "otaku",
      "face": "serious",
      "text": "방금 그거 한 줄이었는데요."
    },
    {
      "do": "say",
      "who": "gpi",
      "face": "hit",
      "text": "…!"
    },
    {
      "do": "say",
      "who": "gpi",
      "face": "attack",
      "text": "…나머지 두 줄은 전투로 대신하겠습니다."
    }
  ],
